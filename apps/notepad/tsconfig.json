{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["webpack/module", "webpack-env"],
    "baseUrl": "src",
    "paths": {
      "components/*": ["../../src/components/*"]
    }
  },
  "include": ["src", "../../src/components"]
}