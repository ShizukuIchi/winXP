{
  "name": "winXP",
  "version": "0.1.0",
  "private": true,
  "author": "ShizukuIchi <shizukuichi@gmail.com>",
  "homepage": "https://winxp.now.sh",
  "dependencies": {
    "lodash.samplesize": "^4.2.0",
    "react": "^16.8.6",
    "react-dom": "^16.8.6",
    "react-scripts": "^5.0.1",
    "react-use": "^7.0.1",
    "styled-components": "^4.2.0",
    "webamp": "^1.3.2-beta.2",
    "xp.css": "^0.2.6"
