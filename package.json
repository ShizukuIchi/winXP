    "@typescript-eslint/parser": "^8.44.1",
    "eslint": "^6.4.0",
    "eslint-config-prettier": "^6.3.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-prettier": "^3.1.0",
    "prettier": "^1.18.2",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=10.16.0"
  }
